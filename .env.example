# Bot token from https://discord.com/developers/applications → Bot → Reset Token.
# Required. `docker compose` reads this file; the binary also reads ./.env when
# the variable is not already set in the environment.
DISCORD_BOT_TOKEN=your_bot_token_here

# Optional. Pin the bot to one guild. When set, slash commands are registered as
# guild commands for this guild only, and interactions from any other guild are
# refused. Strongly recommended for self-hosting.
# DISCORD_GUILD_ID=

# Optional. Location of the TOML state file. Docker Compose sets
# /data/config.toml; outside Docker it defaults to ./config.toml.
# CONFIG_PATH=config.toml

# Optional. Concept registry override. Defaults to concepts.toml next to
# CONFIG_PATH; the embedded registry inside the binary is used when the file is
# absent.
# CONCEPTS_PATH=/data/concepts.toml

# Optional. Interpreter that runs the PaddleOCR worker. Defaults to
# "uv run --locked python" when uv is on PATH; OCR enrichment is skipped when
# neither the setting nor uv is available.
# PADDLEOCR_PYTHON=/app/.venv/bin/python
